{
  // Yerelde "dotnet run --project src/WebApi" ile çalıştırıldığında içerik kökü
  // src/WebApi olur; iki üst klasör depo kökü, oradaki watched/ taranır.
  // Docker'da bu değer WatchSettings__FolderPath ortam değişkeniyle (/data/watch)
  // eziliyor, çünkü ortam değişkenleri JSON dosyalarından sonra okunur.
  "WatchSettings": {
    "FolderPath": "../../watched"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
