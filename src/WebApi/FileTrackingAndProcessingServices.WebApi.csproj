<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- SUNUM KATMANI — uygulamanın çalıştırılabilir olan tek projesi.
       Controller'lar Application'daki servis arayüzlerini kullanır.
       Infrastructure'a referansı SADECE Program.cs'teki DI kaydı için var
       (AddInfrastructure); controller'lar Infrastructure'daki hiçbir sınıfı
       tanımaz. Bu referans olmadan somut sınıflar arayüzlere bağlanamazdı —
       bağlama işini yapan yere "composition root" denir, burası orası. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FileTrackingAndProcessingServices.WebApi</RootNamespace>
    <AssemblyName>FileTrackingAndProcessingServices.WebApi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\FileTrackingAndProcessingServices.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\FileTrackingAndProcessingServices.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" /> <!--Swagger/API dokümantasyonu için.-->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" /> <!--Swagger/API dokümantasyonu için.-->

    <!-- "dotnet ef" komutları startup projesinde de bu paketi arar. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
