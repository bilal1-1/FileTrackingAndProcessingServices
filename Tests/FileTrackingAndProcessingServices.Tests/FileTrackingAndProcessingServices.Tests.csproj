<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />

    <!-- Sürüm hizalaması. Web projesi EntityFrameworkCore.Design 10.0.10
         kullandığı için EF Core 10.0.10'a karşı derleniyor; Npgsql ise EF Core
         10.0.4 getiriyor. Bu satır olmadan test projesi 10.0.4'te kalıyor ve
         derleme CS1705 ile patlıyor: referans verilen derleme, projenin
         derlendiğinden daha eski. Eskiden çakışma yoktu çünkü test projesindeki
         SQLite paketi 10.0.10'u çekiyordu; o paket kaldırılınca ortaya çıktı. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />

    <!-- Testler gerçek bir PostgreSQL'e karşı koşuyor. Testcontainers, test
         çalıştırıldığında Docker'da geçici bir postgres container'ı ayağa
         kaldırıp bitince siler. SQLite paketleri kaldırıldı: uygulama
         PostgreSQL'de çalışırken testlerin SQLite'ı doğrulaması, çalıştırılan
         veritabanının test edilmemesi anlamına geliyordu.
         DİKKAT: bu yüzden "dotnet test" için Docker çalışır durumda olmalı. -->
    <!-- WebApplicationFactory: uygulamayı bellek içinde, gerçek boru hattıyla
         (routing, middleware, DI) ayağa kaldırır. Controller sınıfını elle
         "new"lemek yerine bu kullanılıyor — çünkü sınanmak istenen şeylerin
         çoğu (404/400 durum kodları, rota önceliği, hata middleware'i) sınıfın
         içinde değil, boru hattında yaşıyor. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />

    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Testler entity'leri (Domain), servisleri (Application), gerçek
         repository'lerle DbContext'i (Infrastructure) ve HTTP uçlarını (WebApi)
         kullanıyor. Test projesi tüm katmanları görür — kural, uygulama
         katmanlarının birbirini görmemesi üzerine; testin hepsini görmesi
         normaldir ve dışarıdan bakan bir doğrulama sağlar. -->
    <ProjectReference Include="..\..\src\Domain\FileTrackingAndProcessingServices.Domain.csproj" />
    <ProjectReference Include="..\..\src\Application\FileTrackingAndProcessingServices.Application.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\FileTrackingAndProcessingServices.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WebApi\FileTrackingAndProcessingServices.WebApi.csproj" />
  </ItemGroup>

</Project>