<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />

    <!-- GEÇİCİ: Uygulama PostgreSQL'e geçti ve SQLite paketleri web projesinden
         kaldırıldı, ama testler henüz bellek içi SQLite kullanıyor. Geçiş
         tamamlanana kadar derlemenin ve testlerin bozulmaması için paketler
         buraya taşındı. Testler Testcontainers'a alındığında ikisi de silinecek.
         SQLitePCLRaw pin'i CVE-2025-6965 (NU1903) içindir. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FileTrackingAndProcessingServices.csproj" />
  </ItemGroup>

</Project>