<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Test projesi bu klasörün altında (Tests/) duruyor. SDK tarzı projeler
       varsayılan olarak tüm alt klasörlerdeki .cs dosyalarını derlemeye dahil
       eder; bu satır olmadan test dosyaları web projesine karışır ve derleme
       bozulur. Testler kendi projesinden derlenir. -->
  <ItemGroup>
    <Compile Remove="Tests/**" />
    <Content Remove="Tests/**" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" /> <!--Swagger/API dokümantasyonu için.-->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10"> <!--migration oluşturma gibi EF Core araçları (sadece build zamanında lazım, o yüzden PrivateAssets="all").-->
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" /> <!--PostgreSQL'e bağlanmayı sağlayan paket (SQLite'tan geçişte SQLite paketinin yerine geldi).-->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" /> <!--Swagger/API dokümantasyonu için.-->

    <!-- SQLite'tan PostgreSQL'e geçildi. Microsoft.EntityFrameworkCore.Sqlite ile
         birlikte SQLitePCLRaw pin'i de kaldırıldı: o pin yalnızca SQLite'ın yerel
         kitaplığındaki CVE-2025-6965 için vardı, artık o bağımlılık yok. -->
  </ItemGroup>

</Project>
