# Derleme bağlamına (build context) girmemesi gerekenler.
# Buraya yazılanlar "docker build" sırasında Docker'a hiç gönderilmez:
# hem imaj küçülür hem de yereldeki dosyalar container'a sızmaz.

# Yerel derleme çıktıları. Container kendi derlemesini yapar; bunlar
# gönderilirse hem bağlam şişer hem de Linux imajına Windows çıktıları karışır.
**/bin/
**/obj/

# SQLite döneminden kalan yerel veritabanı dosyaları. Uygulama artık PostgreSQL
# kullanıyor ve verisini ayrı bir container'ın volume'ünde tutuyor, ama bu
# dosyalar proje klasöründe duruyor olabilir; imaja sızmalarına gerek yok.
*.db
*.db-wal
*.db-shm

# İzlenen klasör. İçeriği çalışma anında host'tan bağlanıyor (docker-compose.yml
# içindeki :ro mount), imaja gömülmemeli — aksi halde container her açılışta
# imajdaki eski kopyayı da taşırdı.
izlenen/

# Testler container'da çalışmıyor, imajda yer kaplamalarına gerek yok.
Tests/

# Sürüm kontrolü ve editör dosyaları
.git/
.gitignore
.gitattributes
.vs/
.vscode/

# Dokümantasyon ve Docker'ın kendi dosyaları
*.md
Dockerfile
.dockerignore
